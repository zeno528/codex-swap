#!/usr/bin/env bash
# pre-commit: 仅在改动发布物相关文件时自动递增 VERSION（唯一版本源，patch，99 进位）
# 三处源码为 @VERSION@ 占位符，由 scripts/build.sh 在构建/发布时注入；tag 不发版时不打
# 文档/CI/元数据改动不递增，避免版本信号失真（README 提交不给用户制造"假更新"）
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VF="$ROOT/VERSION"

[ -f "$VF" ] || { echo "pre-commit: 跳过版本递增（缺 $VF）"; exit 0; }

# 发布物相关路径：改动这些才递增；其余（README/docs/CI/.githooks 等）跳过
is_release_change() {
    while IFS= read -r f; do
        case "$f" in
            linux/*|windows/src/*|windows/bin/*|windows/install.ps1|windows/uninstall.ps1|scripts/build.sh)
                return 0 ;;
        esac
    done < <(git diff --cached --name-only)
    return 1
}

if ! is_release_change; then
    echo "pre-commit: 未改动发布物相关文件，跳过版本递增"
    exit 0
fi

bump() {
    IFS='.' read -r major minor patch <<< "$1"
    patch=$((patch + 1))
    if [ "$patch" -gt 99 ]; then
        patch=0
        minor=$((minor + 1))
        if [ "$minor" -gt 99 ]; then
            minor=0
            major=$((major + 1))
        fi
    fi
    echo "$major.$minor.$patch"
}

cur="$(tr -d '[:space:]' < "$VF")"
head_ver="$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]' || true)"

# 幂等：工作区 VERSION 已与 HEAD 不同（手动发版或上次已递增）则不重复递增
if [ -n "$head_ver" ] && [ "$cur" != "$head_ver" ]; then
    echo "pre-commit: VERSION 已由工作区改动（$head_ver → $cur），跳过递增"
    exit 0
fi

new="$(bump "$cur")"
printf '%s\n' "$new" > "$VF"
git add "$VF"
echo "pre-commit: 版本号 $cur → $new（VERSION 已更新，构建时注入三处）"
