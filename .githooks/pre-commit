#!/usr/bin/env bash
# pre-commit: 仅在改动发布物相关文件时自动递增 VERSION（唯一版本源，patch，99 进位）
# 递增后同步三处源码版本号（linux/codex-switch、windows psm1/psd1），保持与 VERSION 一致
# 文档/CI/元数据改动不递增，避免版本信号失真（README 提交不给用户制造"假更新"）
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VF="$ROOT/VERSION"
source "$ROOT/.githooks/lib.sh"

[ -f "$VF" ] || { echo "pre-commit: 跳过版本递增（缺 $VF）"; exit 0; }

# 发布物相关路径：改动这些才递增；其余（README/docs/CI/.githooks 等）跳过（见 lib.sh）

if ! is_release_change; then
    echo "pre-commit: 未改动发布物相关文件，跳过版本递增"
    exit 0
fi

bump() {
    IFS='.' read -r major minor patch <<< "$1"
    patch=$((patch + 1))
    if [ "$patch" -gt 99 ]; then
        patch=0
        minor=$((minor + 1))
        if [ "$minor" -gt 99 ]; then
            minor=0
            major=$((major + 1))
        fi
    fi
    echo "$major.$minor.$patch"
}

cur="$(tr -d '[:space:]' < "$VF")"
head_ver="$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]' || true)"

# 幂等：工作区 VERSION 已与 HEAD 不同（手动发版或上次已递增）则不重复递增
if [ -n "$head_ver" ] && [ "$cur" != "$head_ver" ]; then
    echo "pre-commit: VERSION 已由工作区改动（$head_ver → $cur），跳过递增"
    exit 0
fi

new="$(bump "$cur")"
printf '%s\n' "$new" > "$VF"
git add "$VF"
# 同步三处源码版本（源码为固化版本号，不再是 @VERSION@ 占位符；文件缺失时跳过）
if [ -f "$ROOT/linux/codex-switch" ]; then
    sed -i "s/^VERSION=\"[^\"]*\"/VERSION=\"$new\"/" "$ROOT/linux/codex-switch"
    git add "$ROOT/linux/codex-switch"
fi
if [ -f "$ROOT/windows/src/codex-switch.psm1" ]; then
    sed -i "s/^\(\$script:ScriptVersion[[:space:]]*=[[:space:]]*'\)[^']*'/\1$new'/" "$ROOT/windows/src/codex-switch.psm1"
    git add "$ROOT/windows/src/codex-switch.psm1"
fi
if [ -f "$ROOT/windows/src/codex-switch.psd1" ]; then
    sed -i "s/^\([[:space:]]*ModuleVersion[[:space:]]*=[[:space:]]*'\)[^']*'/\1$new'/" "$ROOT/windows/src/codex-switch.psd1"
    git add "$ROOT/windows/src/codex-switch.psd1"
fi
echo "pre-commit: 版本号 $cur → $new（VERSION 与三处源码已同步）"
# 提交消息可从命令行获取时（-m/-F/--amend）直接写 changelog 并随本次提交入库；
# pre-commit 阶段 git add 有效（提交树尚未冻结）。编辑器交互提交由 prepare-commit-msg 兜底。
msg="$(get_commit_msg || true)"
if [ -n "$msg" ]; then
    write_changelog_entry "$msg"
    echo "pre-commit: $msg 已记录到 CHANGELOG（v$new）"
fi
