#!/usr/bin/env bash
# pre-commit: 提交时自动递增 VERSION 文件（唯一版本源，patch，99 进位）
# 三处源码为 @VERSION@ 占位符，由 scripts/build.sh 在构建/发布时注入；tag 不发版时不打
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
VF="$ROOT/VERSION"

[ -f "$VF" ] || { echo "pre-commit: 跳过版本递增（缺 $VF）"; exit 0; }

bump() {
    IFS='.' read -r major minor patch <<< "$1"
    patch=$((patch + 1))
    if [ "$patch" -gt 99 ]; then
        patch=0
        minor=$((minor + 1))
        if [ "$minor" -gt 99 ]; then
            minor=0
            major=$((major + 1))
        fi
    fi
    echo "$major.$minor.$patch"
}

cur="$(tr -d '[:space:]' < "$VF")"
head_ver="$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]' || true)"

# 幂等：工作区 VERSION 已与 HEAD 不同（手动发版或上次已递增）则不重复递增
if [ -n "$head_ver" ] && [ "$cur" != "$head_ver" ]; then
    echo "pre-commit: VERSION 已由工作区改动（$head_ver → $cur），跳过递增"
    exit 0
fi

new="$(bump "$cur")"
printf '%s\n' "$new" > "$VF"
git add "$VF"
echo "pre-commit: 版本号 $cur → $new（VERSION 已更新，构建时注入三处）"
