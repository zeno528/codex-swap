#!/usr/bin/env bash
# prepare-commit-msg: 发布物提交时写 CHANGELOG.md（pre-commit 已用 -m/-F/--amend 写入时幂等跳过）
# 兜底场景：编辑器交互提交等 pre-commit 拿不到消息的路径——这里消息文件已生成（$1），
# 写入工作区与 index；由于 git 提交树在 prepare-commit-msg 阶段已冻结（实测 git add 不进本次提交），
# 由 post-commit 检测到未提交的 changelog 改动后自动 amend 并入。
# 主路径（-m 等）pre-commit 已写入并进入提交树，本 hook 幂等跳过，不会触发 amend。
set -euo pipefail

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

ROOT="$(git rev-parse --show-toplevel)"
source "$ROOT/.githooks/lib.sh"

# 非发布物提交（README/docs/CI/.githooks 等）：不产生新版本，不写 changelog
is_release_change || exit 0

msg="$(grep -m1 -v '^[[:space:]]*$' "$MSG_FILE" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
write_changelog_entry "$msg"
